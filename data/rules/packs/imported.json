      "id": "import.no-ai-slop-skill.often-empty-adverbs",
      "version": 2,
      "name": "Dense filler adverbs",
      "description": "Adverbs like just, literally, honestly and simply used densely enough that most add rhythm but no meaning.",
      "category": "rhythm",
      "severity": "info",
      "determinism": "heuristic",
      "detection": {
        "kind": "density",
        "lexicon": [
          "just",
          "literally",
          "honestly",
          "simply",
          "actually",
          "truly",
          "fundamentally",
          "importantly",
          "crucially",
          "inherently",
          "inevitably"
        ],
        "per100Words": 2,
        "minOccurrences": 3,
        "minWords": 80
      },
      "remediation": {
        "guidance": "Cut the ones that carry nothing; keep those that mark real emphasis, contrast or the writer's spoken rhythm."
      },
      "source": {
        "type": "webpage",
