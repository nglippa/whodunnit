      "id": "slop.summary-openers",
      "version": 1,
      "name": "Stock summary opener",
      "description": "“In conclusion,” / “In summary,” opening a sentence.",
      "category": "transition",
      "severity": "suggestion",
      "determinism": "deterministic",
