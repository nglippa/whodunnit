  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifact",
    "experimentId",
    "state",
    "selection",
    "client",
    "stageProfiles",
    "session",
    "environment",
    "presentation",
    "capture",
    "authorization",
    "preDrawLock"
  ],
