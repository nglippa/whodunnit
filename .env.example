# Whodunnit environment. Copy to .env.local and fill in what you need.
# Every variable is optional: with none set, the app runs in demo mode
# (deterministic, rule-based reconstruction, no network calls).

# --- Writing model (server-side only; never exposed to the browser) ---
# Anthropic API key. When set, reconstruction, meaning checks and voiceprint
# observations use the model. When unset, the demo engine is used.
ANTHROPIC_API_KEY=

# Google Gemini API key (alternative to Anthropic). GOOGLE_API_KEY also works.
GEMINI_API_KEY=

# Model id. Defaults to claude-sonnet-5 (Anthropic) or gemini-3.8-flash (Gemini).
WHODUNNIT_MODEL=

# Provider selection: auto (default: Anthropic if its key is set, else Gemini
# if its key is set, else demo), anthropic, gemini, local (any OpenAI-format
# server, e.g. a local llama.cpp/Bonsai server or Ollama), or demo (force
# rule-based mode even when a key exists).
WHODUNNIT_AI_PROVIDER=auto

# For WHODUNNIT_AI_PROVIDER=local: the server's OpenAI-compatible base URL
# (default http://127.0.0.1:8080/v1) and an optional bearer token.
WHODUNNIT_OPENAI_BASE_URL=
WHODUNNIT_OPENAI_API_KEY=

# --- Persistence (optional, not wired to the UI in V1) ---
# V1 stores drafts and voiceprints in the author's browser. The Supabase
# repositories (src/lib/persistence/supabase.ts) and schema
# (supabase/migrations/0001_initial.sql) are ready for when accounts ship.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
